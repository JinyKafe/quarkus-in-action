              <data key="d5" xml:space="preserve"><![CDATA[-->
query {
  cars {
    id
    licensePlateNumber
    manufacturer
    model
  }
}

<--
{
  "data": {
    "cars": [
      {
        "id": 1,
        "licensePlateNumber": "ABC123",
        "manufacturer": "Mazda",
        "model": "6"
      },
      {
        "id": 2,
        "licensePlateNumber": "XYZ987",
        "manufacturer": "Ford",
        "model": "Mustang"
      }
    ]
  }
}
]]></data>
